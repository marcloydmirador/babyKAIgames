# Environment Variables for Baby KAI Games
# Copy this file to .env.local and fill in your actual API keys

# OpenAI API Key for AI features
OPENAI_API_KEY=your_openai_api_key_here

# PayPal Configuration (use marcloyd.mirador@live.com)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Database (if using one later)
DATABASE_URL=your_database_url_here

# NextAuth Secret (for user authentication)
NEXTAUTH_SECRET=your_nextauth_secret_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Baby KAI Games"
